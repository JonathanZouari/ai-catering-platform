# Copy to .env (never commit .env). Values differ per environment (dev / prod).

APP_ENV=development

# Supabase — use the DEV project locally and in Railway "development".
# Postgres connection string (Supabase → Project Settings → Database → Connection pooler).
# Use the Session pooler string; postgres:// is fine (the app switches it to psycopg 3). docs/DEPLOY.md
DATABASE_URL=
# Customer login (ADR 0005) needs both. The project must use asymmetric JWT signing keys, and the
# email template must include {{ .Token }} so customers get a 6-digit code.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only. Never expose to the browser or commit.
SUPABASE_SERVICE_ROLE_KEY=

# Temporary owner login for /admin (customers use Supabase Auth, ADR 0005; the owner moves there later).
# Long random value, e.g. python -c "import secrets; print(secrets.token_urlsafe(32))".
# Unset = admin API refuses everyone. Local dev without Postgres: DATABASE_URL=sqlite:///./dev.db
ADMIN_TOKEN=

# Email notifications (OPEN_DECISIONS #13): owner on new orders, customer on approve/reject.
# Sent through Brevo's HTTPS API when BREVO_API_KEY is set (Railway blocks outbound SMTP below
# its Pro plan), else over SMTP. Neither = emails are skipped (only the kind is logged).
# SMTP_FROM is the sender either way; with Brevo it must be a verified sender there.
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
OWNER_EMAIL=
# Base URL used in email links, e.g. https://<app>.up.railway.app
PUBLIC_BASE_URL=http://127.0.0.1:8000

# AI ordering assistant (OPEN_DECISIONS #16: Anthropic Claude). Server-side only. Unset = the chat
# panel is hidden and POST /api/orders/{id}/chat answers 503.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-sonnet-5-5
# Local E2E only: point at a fake Claude server. Leave unset everywhere else.
ANTHROPIC_BASE_URL=
