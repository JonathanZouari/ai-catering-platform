erDiagram
  allergens {
    int id PK
    str name
  }
  blocked_dates {
    uuid id PK
    date date
    str reason
  }
  business_settings {
    bool id PK
    int lead_time_days
    int edit_cutoff_hours
    numeric min_food_total
  }
  customers {
    uuid id PK
    str full_name
    str email
    str phone
  }
  delivery_zones {
    uuid id PK
    str name
    numeric fee
    object definition
  }
  dish_categories {
    uuid id PK
    str name_he
    str name_ar
    str name_en
  }
  geocode_cache {
    str address_norm PK
    float lat
    float lon
    bool found
  }
  time_slots {
    uuid id PK
    FulfillmentType fulfillment_type
    int weekday
    time start_time
  }
  dishes {
    uuid id PK
    uuid category_id FK
    str name_he
    str name_ar
    str name_en
  }
  events {
    uuid id PK
    uuid customer_id FK
    str event_type
    date event_date
    int adults
  }
  quantity_rules {
    uuid id PK
    uuid category_id FK
    numeric per_adult
    numeric per_child
    numeric round_step
  }
  dish_allergens {
    uuid dish_id PK,FK
    int allergen_id PK,FK
    AllergenStatus status
  }
  dish_dietary {
    uuid dish_id PK,FK
    KashrutClass kashrut_class
    bool is_vegetarian
    bool is_vegan
  }
  orders {
    uuid id PK
    uuid customer_id FK
    uuid event_id FK
    uuid time_slot_id FK
    uuid delivery_zone_id FK
    OrderStatus status
    int version
    str access_token_hash
  }
  ai_conversations {
    uuid id PK
    uuid order_id FK
    object created_at
  }
  order_items {
    uuid id PK
    uuid order_id FK
    uuid dish_id FK
    numeric quantity
    str snapshot_name
    PricingUnit snapshot_pricing_unit
  }
  ai_change_proposals {
    uuid id PK
    uuid order_id FK
    uuid conversation_id FK
    int base_order_version
    object changes
    object diff
  }
  ai_messages {
    uuid id PK
    uuid conversation_id FK
    int seq
    str role
    object content
  }
  dish_categories ||--o{ dishes : category_id
  customers ||--o{ events : customer_id
