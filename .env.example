# Copy to .env (never commit .env). Values differ per environment (dev / prod).

APP_ENV=development

# SQLite database file (docs/ADR/0005-sqlite-database.md). Relative paths resolve from the repo
# root; default is data/catering.sqlite3. In Railway, point this at a mounted volume.
SQLITE_PATH=data/catering.sqlite3
# Apply pending migrations on startup. Non-destructive and safe to repeat.
DB_AUTO_MIGRATE=true

# Supabase Storage/Auth only (optional; the database is SQLite).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only. Never expose to the browser or commit.
SUPABASE_SERVICE_ROLE_KEY=

# LLM provider — undecided (docs/OPEN_DECISIONS.md #16). Added in Phase 4.
