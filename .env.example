# Copy to .env (never commit .env). Values differ per environment (dev / prod).

APP_ENV=development

# Prototype database: a SQLite file. Relative paths resolve against the repo root. Empty = data/catering.db.
# On Railway the container disk is wiped on every redeploy unless a volume is mounted there.
DATABASE_PATH=

# Supabase — not used while the prototype runs on SQLite. Use the DEV project locally and in Railway "development".
# Postgres connection string (Supabase → Project Settings → Database → Connection pooler).
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only. Never expose to the browser or commit.
SUPABASE_SERVICE_ROLE_KEY=

# LLM provider — undecided (docs/OPEN_DECISIONS.md #16). Added in Phase 4.
