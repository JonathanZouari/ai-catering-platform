# Copy to .env (never commit .env). Values differ per environment (dev / prod).

APP_ENV=development

# Supabase — use the DEV project locally and in Railway "development".
# Postgres connection string (Supabase → Project Settings → Database → Connection pooler).
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only. Never expose to the browser or commit.
SUPABASE_SERVICE_ROLE_KEY=

# Tests only. A disposable Postgres; its database name must contain "test".
# The test suite WIPES this database. Never point it at Supabase.
TEST_DATABASE_URL=

# Server-side only. Without it the chat is off and hand ordering still works.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
# Per caterer, per month (OPEN_DECISIONS #16).
AI_MONTHLY_MESSAGE_LIMIT=1000
