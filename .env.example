# Copy to .env (never commit .env). Values differ per environment (dev / prod).

APP_ENV=development

# Supabase: use the DEV project locally and in Railway "development" (ADR 0004).
# Postgres connection string: Supabase > Connect > Session pooler. Both postgresql:// and
# postgresql+psycopg:// work. Leave empty locally to use the SQLite file backend/catering.db
# (create it with `uv run python -m app.seed`).
DATABASE_URL=
SUPABASE_URL=
# Safe in the browser (served by GET /api/config); RLS limits what it can do.
SUPABASE_PUBLISHABLE_KEY=
# Server-side only (Storage uploads). Never expose to the browser or commit.
SUPABASE_SECRET_KEY=
# Only for the Supabase CLI (db push / link). Not read by the app.
SUPABASE_DB_PASSWORD=

# Demo owner for local testing, created in Supabase Auth with app_metadata.role = "owner".
# Never use these values outside a dev project.
DEMO_OWNER_EMAIL=
DEMO_OWNER_PASSWORD=

# LLM provider: undecided (docs/OPEN_DECISIONS.md #16). Added in Phase 4.
