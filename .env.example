# Copy to .env (never commit .env). Values differ per environment (dev / prod).

APP_ENV=development

# Leave DATABASE_URL empty to use a local SQLite file (~/.local/share/ai-catering-platform/catering.db, or under XDG_DATA_HOME), created on startup.
# Supabase — use the DEV project locally and in Railway "development".
# Postgres connection string (Supabase → Project Settings → Database → Connection pooler).
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only. Never expose to the browser or commit.
SUPABASE_SERVICE_ROLE_KEY=

# LLM provider — undecided (docs/OPEN_DECISIONS.md #16). Added in Phase 4.
