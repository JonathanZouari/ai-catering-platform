# Copy to .env (never commit .env). Values differ per environment (dev / prod).

APP_ENV=development

# Supabase Postgres through the session pooler (Project Settings > Database > Connect).
# The app connects as a privileged role; RLS limits only the Data API and Realtime.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-eu-central-1.pooler.supabase.com:5432/postgres

# Tests wipe these, so each must be its own database with "test" in its name.
TEST_DATABASE_URL=
E2E_DATABASE_URL=

# Supabase Auth, Storage and Realtime. Use the DEV project locally.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only. Never expose to the browser or commit.
SUPABASE_SERVICE_ROLE_KEY=

# The slug of the caterer whose site is served at / (ADR 0008).
SITE_CATERER=

# Server-side only. Without it the chat is off and hand ordering still works.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
# Per caterer, per month (OPEN_DECISIONS #16).
AI_MONTHLY_MESSAGE_LIMIT=1000

# Server-side only. New-order emails to caterers. Without the key none are sent.
RESEND_API_KEY=
# A sender on a domain verified with Resend, e.g. Yummai <orders@example.com>.
EMAIL_FROM=
# The site's own address, used for the dashboard link in emails.
PUBLIC_BASE_URL=
